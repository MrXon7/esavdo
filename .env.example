# Telegram Botfather'dan olingan token
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Supabase PostgreSQL connection string (Transaction pooler yoki Direct connection)
# Masalan: postgresql://postgres.xxxx:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/esavdo

# Render Web Service tashqi webhook manzili
# Masalan: https://my-store.onrender.com/telegram-webhook
WEBHOOK_URL=https://my-store.onrender.com/telegram-webhook

# Render tashqi ochiq URL manzili (self-ping uchun)
# Masalan: https://my-store.onrender.com
RENDER_EXTERNAL_URL=https://my-store.onrender.com

# Yangi buyurtmalar inline tasdiqlash tugmalari bilan boradigan Telegram guruh yoki admin ID si (masalan -1001234567890)
ADMIN_GROUP_ID=-1001234567890

# Mahsulot / aksiya e'lonlari yuboriladigan Telegram guruh yoki kanal ID si (masalan -1001987654321)
PRODUCT_ANNOUNCE_GROUP_ID=-1001987654321

# Do'kon nomi va brending (butun tizim shu yerdan boshqariladi)
STORE_NAME=Online Savdo
STORE_DESCRIPTION=Sifatli va qulay xaridlar platformasi
STORE_CURRENCY=so'm
STORE_CONTACT_PHONE=+998 90 123 45 67

# Dasturchi sozlamalari (True bo'lsa mahalliy test rejimida ishlaydi)
DEBUG=False
